option ClientOutput = "./client/init.luau"
option ServerOutput = "./server/init.luau"
option PromiseLibrary = "ReplicatedStorage.Packages.Promise"

event ide {
    from: Client,
    type: Reliable,
    call: SingleAsync,
    data: (u8)
}

function getLastPlayed {
    yield: Promise,
    return: f64
}

function ecsReceiveFullWorldData {
    yield: Promise,
    return: (unknown, unknown)
}

event ecsUpdate {
    from: Server,
    type: Reliable,
    call: SingleSync,
    data: (unknown, unknown)
}
