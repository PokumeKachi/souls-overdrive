{
  "name": "soul",
  "tree": {
    "$className": "DataModel",
    "Lighting": {
      "$path": "Lighting",
      "$properties": {
        "Brightness": 2,
        "Outlines": false,
        "Ambient": [0, 0, 0],
        "Technology": "Voxel",
        "GlobalShadows": true
      }
    },
    "ReplicatedStorage": {
      "Packages": {
        "$path": "Packages"
      },
      "Shared": {
        "$path": "src/shared",
        "Networking": {
          "$path": "Blink/client"
        }
      }
    },
    "ServerScriptService": {
      "API": {
        "$path": "src/serverApi",
        "Networking": {
          "$path": "Blink/server"
        }
      },
      "Server": {
        "$path": "src/server"
      }
    },
    "ServerStorage": {
      "Packages": {
        "$path": "ServerPackages"
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Workspace": {
      "$path": "Workspace"
    }
  }
}
